{
  "name": "shift-scheduler",
  "version": "2.0.0",
  "private": true,
  "description": "店舗向けシフト作成支援Webアプリ - メンバー管理、希望表読み取り、自動シフト生成、Excel/JSON入出力",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-assets.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint src/lib/v2 src/components/v2 --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "postinstall": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "next": "^16.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.16.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.0"
  }
}
